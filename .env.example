# Copy this file to .env and fill in your own local settings.
# Never commit your populated .env or paste a real connection URL into GitHub.
# Local format: postgresql://USER:PASSWORD@localhost:5432/examregdb
# Use your provider's full URL (including its TLS settings) for a hosted database.
DATABASE_URL=

# Generate a private key with: python -c "import secrets; print(secrets.token_hex(32))"
# Paste the generated value below in .env only; keep it stable between restarts.
SECRET_KEY=
